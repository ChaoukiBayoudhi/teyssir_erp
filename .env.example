# Teyssir ERP — copy to .env and adjust. NEVER commit the real .env.

# Node role: "hub" (PostgreSQL, sync master, reporting) or "till" (local SQLite, offline POS)
TEYSSIR_ROLE=till
# Till series code (C1/C2/C3) — used as the per-terminal numbering prefix. Ignored on hub.
TEYSSIR_TERMINAL=C1
# Hub a till syncs to (spec §4.4)
TEYSSIR_HUB_URL=https://teyssir-hub.local

SECRET_KEY=dev-only-insecure-change-me
DEBUG=1

# Hub PostgreSQL (used only when TEYSSIR_ROLE=hub)
POSTGRES_DB=teyssir
POSTGRES_USER=teyssir
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
