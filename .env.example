# Teyssir ERP — copy to .env and adjust. NEVER commit the real .env.
#
# NOTE: the Windows/macOS installers (deploy/windows, deploy/macos) generate a .env for you
# with random secrets. Use this file only for a manual/dev setup. Ready-made role templates:
#   deploy/windows/.env.hub.example  ·  deploy/windows/.env.till.example  (and deploy/macos/)

# Node role: "hub" (central server, PostgreSQL or SQLite) or "till" (local SQLite, offline POS)
TEYSSIR_ROLE=till
# Till series code (C1/C2/C3) — the per-terminal numbering prefix. Ignored on a hub.
TEYSSIR_TERMINAL=C1
# Store code: empty for a single store; e.g. S1 in a multi-store chain (globally-unique numbers).
TEYSSIR_STORE_CODE=

# --- Till → hub sync (spec §4.4) ---
# The hub is served over HTTP on port 8000 by default (waitress). Use its hostname or IP.
TEYSSIR_HUB_URL=http://teyssir-hub.local:8000
# Shared secret — MUST be identical on the hub and every till, or sync is refused.
TEYSSIR_SYNC_KEY=change-me-to-a-long-random-string

# --- Security ---
SECRET_KEY=dev-only-insecure-change-me
DEBUG=1
# Hosts/IPs this node answers to (add the machine's hostname/IP for LAN access):
TEYSSIR_ALLOWED_HOSTS=localhost,127.0.0.1,teyssir-hub.local
# Set to 1 ONLY when served behind HTTPS (e.g. a cloud hub): enables secure cookies + redirect.
# TEYSSIR_HTTPS=0

# --- Hub database (default sqlite; set postgres for heavier/multi-store use) ---
TEYSSIR_DB=sqlite
# Used only when TEYSSIR_DB=postgres:
# POSTGRES_DB=teyssir
# POSTGRES_USER=teyssir
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# --- Local AI (Ollama, optional; ERP runs without it) ---
USE_LLM=false
LLM_PROVIDER=ollama
LLM_MODEL=mistral
# TEYSSIR_OLLAMA_URL=http://127.0.0.1:11434
# TEYSSIR_OCR_PROVIDER=tesseract
# TEYSSIR_OCR_PROVIDER=vision
# TEYSSIR_VISION_MODEL=qwen2.5vl:3b
# TEYSSIR_SCAN_EXECUTOR=thread
