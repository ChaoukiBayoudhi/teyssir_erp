# ============================================================
#  Teyssir — HUB PC (serveur central du magasin)
#  Copy this file to  .env  in the project ROOT, then edit.
#  (The HUB PC is the "PC-1 / Teyssir Hub" — it is NOT a till.)
# ============================================================

TEYSSIR_ROLE=hub

# Store code: leave EMPTY for a single store. Set (e.g. S1) only if several
# stores are consolidated under a cloud hub.
TEYSSIR_STORE_CODE=

# --- Database -------------------------------------------------
# sqlite  = simplest, no extra software, fine for one shop (recommended).
# postgres= for heavier / multi-store use (install PostgreSQL first).
TEYSSIR_DB=sqlite
# Only used when TEYSSIR_DB=postgres:
# POSTGRES_DB=teyssir_hub
# POSTGRES_USER=teyssir
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# --- Security -------------------------------------------------
# Shared secret the tills use to sync with this hub.
# The SAME value MUST be set on every till (TEYSSIR_SYNC_KEY).
TEYSSIR_SYNC_KEY=CHANGE-ME-to-a-long-random-string

DEBUG=0
SECRET_KEY=CHANGE-ME-to-a-long-random-string
# List this PC's hostname / IP so the tills can reach it:
TEYSSIR_ALLOWED_HOSTS=localhost,127.0.0.1,teyssir-hub.local
TEYSSIR_CSRF_TRUSTED_ORIGINS=http://teyssir-hub.local:8000

# --- Optional: multi-store cloud hub (Phase 6) ----------------
# TEYSSIR_CLOUD_HUB_URL=https://cloud.teyssir.example
# TEYSSIR_CLOUD_SYNC_KEY=change-me

# --- Optional: high-accuracy book OCR (free, offline) ---------
# TEYSSIR_OCR_PROVIDER=vision        # needs Ollama + a vision model
# TEYSSIR_SCAN_EXECUTOR=thread       # don't block the scan request

USE_LLM=false
LLM_PROVIDER=ollama
LLM_MODEL=mistral
