# ============================================================
#  Teyssir — TILL PC (caisse / point de vente)
#  Copy this file to  .env  in the project ROOT, then edit.
#  One .env per till. Each till MUST have a UNIQUE terminal code.
# ============================================================

TEYSSIR_ROLE=till

# UNIQUE per till:  C1  (caisse 1),  C2,  C3 ...
TEYSSIR_TERMINAL=C1

# Leave EMPTY for a single store; set (e.g. S1) only in a multi-store chain.
TEYSSIR_STORE_CODE=

# --- Link to the hub -----------------------------------------
# Address of the HUB PC on the shop network (hostname or IP):
TEYSSIR_HUB_URL=http://teyssir-hub.local:8000
# MUST be exactly the same value as the hub's TEYSSIR_SYNC_KEY:
TEYSSIR_SYNC_KEY=CHANGE-ME-same-key-as-the-hub

# --- Security -------------------------------------------------
DEBUG=0
SECRET_KEY=CHANGE-ME-to-a-long-random-string
TEYSSIR_ALLOWED_HOSTS=localhost,127.0.0.1
